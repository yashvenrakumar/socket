# Node modules
backend/node_modules/
frontend/node_modules/
mobileapp/node_modules/
**/node_modules/

# Git directories - ignore .git folders recursively inside backend, frontend, mobileapp
backend/**/.git/
backend/**/.git
frontend/**/.git/
frontend/**/.git
mobileapp/**/.git/
mobileapp/**/.git
**/.git/
**/.git

# Gitignore files - ignore .gitignore files recursively inside backend, frontend, mobileapp
backend/**/.gitignore
frontend/**/.gitignore
mobileapp/**/.gitignore

# Environment files
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
mobileapp/.env
mobileapp/.env.*
**/.env
**/.env.*

# Build outputs
backend/dist/
backend/build/
frontend/dist/
frontend/build/
mobileapp/dist/
mobileapp/build/
**/dist/
**/build/

# Logs
**/*.log
backend/*.log
frontend/*.log
mobileapp/*.log

# OS files
.DS_Store
**/.DS_Store
backend/.DS_Store
frontend/.DS_Store
mobileapp/.DS_Store

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage
**/coverage/
**/.nyc_output/

# Temporary files
*.tmp
*.temp
**/*.tmp
**/*.temp
